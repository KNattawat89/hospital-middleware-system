APP_NAME=hospital-middleware-system
APP_PORT=8080
APP_DEBUG=false

# Migrations are embedded in the binary (infra/db/migrations) and run
# in-process via fx.Invoke(db.Migrate) - set true to apply them on boot.
APP_MIGRATE=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hospital_middleware
DB_SSLMODE=disable

# Only needed by cmd/gen-model to introspect the live schema.
GOOSE_DBSTRING=host=localhost port=5432 user=postgres password=postgres dbname=hospital_middleware sslmode=disable

# Used by `task db-migrate-up` / `task db-migrate-down` (goose CLI).
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=infra/db/migrations

JWT_SECRET=changeme
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
